{
    "name": "rain-usdr-sqd",
    "version": "1.0.0",
    "scripts": {
        "build": "rm -rf lib && tsc",
        "codegen:abi": "squid-evm-typegen src/abi ./abi/*.json",
        "codegen:model": "squid-typeorm-codegen",
        "db:generate": "npx squid-typeorm-migration generate",
        "db:migrate": "npx squid-typeorm-migration apply",
        "format": "prettier --check --write .prettierrc *.json **/*.{json,ts}",
        "index": "npx tsc && node -r dotenv/config lib/main.js",
        "squid-api:start": "node -r dotenv/config node_modules/@subsquid/graphql-server/bin/run.js",
        "squid-etl:start": "node -r dotenv/config lib/main.js",
        "update": "npx npm-check-updates --filter /subsquid/ --upgrade && npm i -f"
    },
    "author": "Rain Team",
    "license": "MIT",
    "dependencies": {
        "@subsquid/evm-abi": "^0.3.1",
        "@subsquid/evm-processor": "^1.27.0",
        "@subsquid/graphql-server": "^4.9.0",
        "@subsquid/typeorm-migration": "^1.3.0",
        "@subsquid/typeorm-store": "^1.5.1",
        "dotenv": "^16.4.7",
        "typeorm": "^0.3.21"
    },
    "devDependencies": {
        "@subsquid/evm-typegen": "^4.3.0",
        "@subsquid/typeorm-codegen": "^2.0.2",
        "prettier": "^3.5.3",
        "prettier-plugin-package": "^1.4.0",
        "prettier-plugin-sort-imports": "^1.8.6",
        "typescript": "^5.8.2"
    },
    "allowScripts": {
        "@apollo/protobufjs@1.2.8": true,
        "@apollo/protobufjs@1.2.6": true,
        "bufferutil@4.1.0": true,
        "es5-ext@0.10.64": true,
        "keccak@3.0.4": true,
        "utf-8-validate@5.0.10": true
    }
}
